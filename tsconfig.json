{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    // **키를 지우면 안 된다.** next(dev·build·typegen)가 시작할 때
    // `writeConfigurationDefaults`로 tsconfig를 다시 쓰는데, allowJs는 거기서
    // 'suggested'라 **키가 없을 때만** true를 넣는다. 끄려면 지우지 말고 false로
    // 남겨 둘 것 — 값이 있으면 그대로 둔다.
    // false인 이유: include에 js 글롭이 없어도 .ts에서 import하면 program에
    // 딸려 들어오고, 그 파일은 checkJs 없이 무검사로 지나간다. 막아 두면 그런
    // import가 조용히 통과하는 대신 컴파일 에러가 된다.
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // Panda가 생성하는 트리(outdir). 저장소에 커밋하지 않으므로 clone 직후엔
      // 없다 — `pnpm install`의 prepare(panda codegen)가 만든다.
      "styled-system/*": ["./styled-system/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "vitest.config.mts",
    "vitest.setup.ts"
  ]
}
